<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Microsoft.TestPlatform.TestHost trae recursos con locales que .NET no reconoce; es ruido del paquete, no del código. -->
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Citas.Domain/Citas.Domain.csproj" />
    <ProjectReference Include="../../src/Citas.Application/Citas.Application.csproj" />
    <ProjectReference Include="../../src/Citas.Infrastructure/Citas.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Citas.Api/Citas.Api.csproj" />
  </ItemGroup>

</Project>
