{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal",
        "Microsoft.EntityFrameworkCore.Update": "Fatal",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Clinic": {
    "TimeZone": "America/Bogota"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Demo": {
    "SeedData": false
  },
  "Jwt": {
    "Issuer": "citas-api",
    "Audience": "citas-clients",
    "ExpiresMinutes": 60
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Docs": {
    "Enabled": true
  }
}
