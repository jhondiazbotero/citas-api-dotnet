{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Clinic": {
    "TimeZone": "America/Bogota"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Demo": {
    "SeedData": false
  },
  "Docs": {
    "Enabled": true
  }
}
