# Copy to .env (git ignores it) and fill in the values. Never commit the real file.
#   cp .env.example .env

# Password of the PostgreSQL user "citas". It goes inside a connection string:
# use letters and digits only (no ; = ' " $ or spaces).
POSTGRES_PASSWORD=cambia-esto

# Key that signs the access tokens (HS256, at least 32 bytes). Generate it with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Password shared by the fictional demo users (admin@demo.local, recepcion@demo.local, ...).
# Pick any long random value; without it the demo users are not created.
DEMO_USERS_PASSWORD=
